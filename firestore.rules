rules_version = '2';
service cloud.firestore {
    match /databases/{database}/documents {
        function validTeam(teamId) {
            return teamId in ['eagles', 'cowboys', 'giants', 'commanders', 'bears', 'lions', 'packers', 'vikings', 'falcons', 'panthers', 'saints', 'buccaneers', 'cardinals', 'rams', '49ers', 'seahawks', 'bills', 'dolphins', 'patriots', 'jets', 'ravens', 'bengals', 'browns', 'steelers', 'texans', 'colts', 'jaguars', 'titans', 'broncos', 'chiefs', 'raiders', 'chargers'];
        }
        function validName(name) {
            return name is string && name.matches('^[A-Za-z0-9][A-Za-z0-9 _-]{0,18}[A-Za-z0-9]$');
        }
        function normalized(value, target) {
            return value >= target ? 100 : int(value * 100 / target);
        }
        match /leagueFans/{entryId} {
            function ownsEntry() {
                return request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && entryId == request.auth.uid + '_' + request.resource.data.teamId;
            }
            function validRecords(records) {
                return records is map
                    && records.keys().hasAll(['game', 'bird', 'search', 'kick', 'pocket', 'shove', 'recall', 'punt', 'blitz', 'signal'])
                    && records.keys().hasOnly(['game', 'bird', 'search', 'kick', 'pocket', 'shove', 'recall', 'punt', 'blitz', 'signal'])
                    && records.game is int && records.game >= 0 && records.game <= 1000000
                    && records.bird is int && records.bird >= 0 && records.bird <= 1000000
                    && records.search is int && records.search >= 0 && records.search <= 1000000
                    && records.kick is int && records.kick >= 0 && records.kick <= 1000000
                    && records.pocket is int && records.pocket >= 0 && records.pocket <= 1000000
                    && records.shove is int && records.shove >= 0 && records.shove <= 1000000
                    && records.recall is int && records.recall >= 0 && records.recall <= 1000000
                    && records.punt is int && records.punt >= 0 && records.punt <= 1000000
                    && records.blitz is int && records.blitz >= 0 && records.blitz <= 1000000
                    && records.signal is int && records.signal >= 0 && records.signal <= 1000000
                    ;
            }
            function validScores(scores, records) {
                return scores is map
                    && scores.keys().hasAll(['game', 'bird', 'search', 'kick', 'pocket', 'shove', 'recall', 'punt', 'blitz', 'signal'])
                    && scores.keys().hasOnly(['game', 'bird', 'search', 'kick', 'pocket', 'shove', 'recall', 'punt', 'blitz', 'signal'])
                    && scores.game is int && scores.game == normalized(records.game, 5)
                    && scores.bird is int && scores.bird == normalized(records.bird, 20)
                    && scores.search is int && scores.search == normalized(records.search, 5)
                    && scores.kick is int && scores.kick == normalized(records.kick, 15)
                    && scores.pocket is int && scores.pocket == normalized(records.pocket, 10)
                    && scores.shove is int && scores.shove == normalized(records.shove, 5)
                    && scores.recall is int && scores.recall == normalized(records.recall, 8)
                    && scores.punt is int && scores.punt == normalized(records.punt, 500)
                    && scores.blitz is int && scores.blitz == normalized(records.blitz, 3)
                    && scores.signal is int && scores.signal == normalized(records.signal, 1)
                    ;
            }
            function validEntry() {
                let entry = request.resource.data;
                return entry.keys().hasAll(['uid', 'teamId', 'nickname', 'scores', 'records', 'points', 'clicks', 'updatedAt'])
                    && entry.keys().hasOnly(['uid', 'teamId', 'nickname', 'scores', 'records', 'points', 'clicks', 'updatedAt'])
                    && validTeam(entry.teamId) && validName(entry.nickname)
                    && validRecords(entry.records) && validScores(entry.scores, entry.records)
                    && entry.points is int && entry.points == entry.scores.game + entry.scores.bird + entry.scores.search + entry.scores.kick + entry.scores.pocket + entry.scores.shove + entry.scores.recall + entry.scores.punt + entry.scores.blitz + entry.scores.signal
                    && entry.clicks is int && entry.clicks >= 0 && entry.clicks <= 9007199254740991
                    && entry.updatedAt == request.time;
            }
            function nondecreasing() {
                let before = resource.data;
                let after = request.resource.data;
                return after.uid == before.uid && after.teamId == before.teamId
                    && after.clicks >= before.clicks
                    && after.records.game >= before.records.game
                    && after.records.bird >= before.records.bird
                    && after.records.search >= before.records.search
                    && after.records.kick >= before.records.kick
                    && after.records.pocket >= before.records.pocket
                    && after.records.shove >= before.records.shove
                    && after.records.recall >= before.records.recall
                    && after.records.punt >= before.records.punt
                    && after.records.blitz >= before.records.blitz
                    && after.records.signal >= before.records.signal
                    ;
            }
            allow list: if request.query.limit != null && request.query.limit <= 25;
            allow get: if request.auth != null && entryId in [request.auth.uid + '_eagles', request.auth.uid + '_cowboys', request.auth.uid + '_giants', request.auth.uid + '_commanders', request.auth.uid + '_bears', request.auth.uid + '_lions', request.auth.uid + '_packers', request.auth.uid + '_vikings', request.auth.uid + '_falcons', request.auth.uid + '_panthers', request.auth.uid + '_saints', request.auth.uid + '_buccaneers', request.auth.uid + '_cardinals', request.auth.uid + '_rams', request.auth.uid + '_49ers', request.auth.uid + '_seahawks', request.auth.uid + '_bills', request.auth.uid + '_dolphins', request.auth.uid + '_patriots', request.auth.uid + '_jets', request.auth.uid + '_ravens', request.auth.uid + '_bengals', request.auth.uid + '_browns', request.auth.uid + '_steelers', request.auth.uid + '_texans', request.auth.uid + '_colts', request.auth.uid + '_jaguars', request.auth.uid + '_titans', request.auth.uid + '_broncos', request.auth.uid + '_chiefs', request.auth.uid + '_raiders', request.auth.uid + '_chargers'];
            allow create: if ownsEntry() && validEntry();
            allow update: if ownsEntry() && validEntry() && nondecreasing();
            allow delete: if false;
        }
        match /teamStandings/{teamId} {
            allow list: if request.query.limit != null && request.query.limit <= 32;
            allow get: if validTeam(teamId);
            allow write: if false;
        }
        match /leagueContributions/{entryId} {
            allow read, write: if false;
        }
        match /barkleyLeaders/{userId} {
            function ownsEntry() {
                return request.auth != null && request.auth.uid == userId;
            }
            function validEntry() {
                let entry = request.resource.data;
                return entry.keys().hasAll(['nickname', 'score', 'updatedAt'])
                    && entry.keys().hasOnly(['nickname', 'score', 'updatedAt'])
                    && entry.nickname is string
                    && entry.nickname.matches('^[A-Za-z0-9][A-Za-z0-9 _-]{0,18}[A-Za-z0-9]$')
                    && entry.score is int && entry.score >= 0 && entry.score <= 1000000
                    && entry.updatedAt == request.time;
            }
            allow list: if request.query.limit != null && request.query.limit <= 25;
            allow get: if ownsEntry();
            allow create: if ownsEntry() && validEntry();
            allow update: if ownsEntry() && validEntry()
                && request.resource.data.score >= resource.data.score;
            allow delete: if false;
        }
        match /clickLeaders/{userId} {
            function ownsEntry() {
                return request.auth != null && request.auth.uid == userId;
            }
            function validEntry() {
                let entry = request.resource.data;
                return entry.keys().hasAll(['nickname', 'clicks', 'updatedAt'])
                    && entry.keys().hasOnly(['nickname', 'clicks', 'updatedAt'])
                    && entry.nickname is string
                    && entry.nickname.matches('^[A-Za-z0-9][A-Za-z0-9 _-]{0,18}[A-Za-z0-9]$')
                    && entry.clicks is int
                    && entry.clicks >= 0
                    && entry.clicks <= 9007199254740991
                    && entry.updatedAt == request.time;
            }
            // Leaderboard entries are intentionally public; reads are bounded.
            allow list: if request.query.limit != null && request.query.limit <= 25;
            allow get: if ownsEntry();
            allow create: if ownsEntry() && validEntry();
            allow update: if ownsEntry() && validEntry()
                && request.resource.data.clicks >= resource.data.clicks;
            allow delete: if false;
        }
    }
}
